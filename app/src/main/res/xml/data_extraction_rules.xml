<?xml version="1.0" encoding="utf-8"?>
<!-- Kassendaten, Mandate und API-Schlüssel gehören nicht in Cloud-Backups -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tresenkasse.xml" />
    </device-transfer>
</data-extraction-rules>
